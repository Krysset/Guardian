{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Guardian chart values",
  "type": "object",
  "required": ["issuerURL", "image", "secrets", "database"],
  "properties": {
    "issuerURL": {
      "type": "string",
      "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
      "description": "The public address of Guardian, the OIDC issuer. Required."
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "description": "The backend image. Required." },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1, "description": "The Secret with Guardian's secrets. Required." },
        "keys": {
          "type": "object",
          "required": ["keyEncryptionKeys", "adminInitialPassword"],
          "properties": {
            "keyEncryptionKeys": { "type": "string", "minLength": 1 },
            "adminInitialPassword": { "type": "string", "minLength": 1 },
            "smtpPassword": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["mode", "passwordKey"],
      "properties": {
        "mode": { "enum": ["bundled", "external"] },
        "passwordSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 },
        "maxConns": { "type": "integer", "minimum": 1 },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
          }
        }
      },
      "if": { "properties": { "mode": { "const": "external" } } },
      "then": {
        "properties": {
          "external": { "required": ["host"], "properties": { "host": { "minLength": 1 } } }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "trustedProxyHops": { "type": "integer", "minimum": 0 },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "migrations": { "type": "object", "properties": { "mode": { "enum": ["startup", "job"] } } },
    "config": {
      "type": "object",
      "properties": {
        "logFormat": { "enum": ["json", "text"] },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "extraEnv": { "type": "object", "additionalProperties": { "type": "string" } },
        "auditRetention": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(s|m|h)([0-9]+(s|m))?$" },
        "deletionGracePeriod": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(s|m|h)([0-9]+(s|m))?$" },
        "signingKeyLifetime": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(s|m|h)([0-9]+(s|m))?$" },
        "mail": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "security": { "enum": ["starttls", "tls", "none"] },
            "username": { "type": "string" },
            "from": { "type": "string" },
            "requireEmail": { "type": "boolean" }
          },
          "if": { "required": ["host"], "properties": { "host": { "minLength": 1 } } },
          "then": { "required": ["from"], "properties": { "from": { "minLength": 3, "description": "The sender. Required with a mail host." } } },
          "else": { "properties": { "requireEmail": { "const": false, "description": "requireEmail needs a mail host." } } }
        },
        "loginLimits": {
          "type": "object",
          "properties": {
            "window": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(s|m|h)([0-9]+(s|m))?$" },
            "perAccountAndIP": { "oneOf": [{ "const": "" }, { "type": "integer", "minimum": 1 }] },
            "perIP": { "oneOf": [{ "const": "" }, { "type": "integer", "minimum": 1 }] }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "image": { "required": ["repository"], "properties": { "repository": { "minLength": 1, "description": "The frontend image. Required when the frontend is enabled." } } }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "metricsFrom": { "type": "array" } }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 9 },
        "recipients": { "type": "array", "items": { "type": "string", "pattern": "^age1[0-9a-z]{20,}$" } },
        "keep": { "type": "integer", "minimum": 0 },
        "withoutAudit": { "type": "boolean" },
        "persistence": {
          "type": "object",
          "properties": { "existingClaim": { "type": "string" }, "size": { "type": "string" }, "storageClass": { "type": "string" } }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "recipients": { "minItems": 1, "description": "The age public keys to encrypt to. Required when backups are enabled." } } }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "className": { "type": "string" } }
    }
  }
}
