{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Guardian chart values",
  "type": "object",
  "required": ["issuerURL", "image", "secrets", "database"],
  "properties": {
    "issuerURL": {
      "type": "string",
      "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
      "description": "The public address of Guardian, the OIDC issuer. Required."
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "description": "The backend image. Required." },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1, "description": "The Secret with Guardian's secrets. Required." },
        "keys": {
          "type": "object",
          "required": ["keyEncryptionKeys", "adminInitialPassword"],
          "properties": {
            "keyEncryptionKeys": { "type": "string", "minLength": 1 },
            "adminInitialPassword": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["mode", "passwordKey"],
      "properties": {
        "mode": { "enum": ["bundled", "external"] },
        "passwordSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 },
        "maxConns": { "type": "integer", "minimum": 1 },
        "external": {
          "type": "object",
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] }
          }
        }
      },
      "if": { "properties": { "mode": { "const": "external" } } },
      "then": {
        "properties": {
          "external": { "required": ["host"], "properties": { "host": { "minLength": 1 } } }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "trustedProxyHops": { "type": "integer", "minimum": 0 },
    "config": {
      "type": "object",
      "properties": {
        "logFormat": { "enum": ["json", "text"] },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "extraEnv": { "type": "object", "additionalProperties": { "type": "string" } },
        "loginLimits": {
          "type": "object",
          "properties": {
            "window": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(s|m|h)([0-9]+(s|m))?$" },
            "perAccountAndIP": { "oneOf": [{ "const": "" }, { "type": "integer", "minimum": 1 }] },
            "perIP": { "oneOf": [{ "const": "" }, { "type": "integer", "minimum": 1 }] }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "className": { "type": "string" } }
    }
  }
}
