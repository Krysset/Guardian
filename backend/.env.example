# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=guardian
DB_PASSWORD=change-me
DB_NAME=guardian
DB_MAX_CONNS=20          # per pod; replicas x this must stay below Postgres max_connections
SCHEMA_PATH=./schema.sql

# --- Listeners ---
PUBLIC_ADDR=:3001        # behind the ingress: UI, OIDC endpoints, /api
INTERNAL_ADDR=:3002      # cluster-only: /introspect, /metrics, /healthz, /readyz

# --- Public identity ---
# Public base URL of Guardian as seen by browsers. https:// enables Secure + __Host- cookies.
ISSUER_URL=http://localhost:3001
# Extra browser origins allowed to call /api (comma separated). ISSUER_URL is always allowed.
ALLOWED_ORIGINS=
# Cluster-internal introspection URL, advertised in OIDC discovery (optional but makes integration easier).
INTROSPECTION_URL=http://localhost:3002/introspect
# Number of reverse proxies (ingress, load balancer) that append to X-Forwarded-For. 0 = none.
TRUSTED_PROXY_HOPS=0

# --- Secrets ---
# Encrypts signing keys at rest. Generate: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
# Optional. If unset, a random admin password is generated and logged once on first start.
ADMIN_INITIAL_PASSWORD=
# Optional, Go duration. Default 168h (one week).
SESSION_TTL=168h
