# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=guardian
DB_PASSWORD=change-me
DB_NAME=guardian
DB_SSLMODE=disable       # disable, allow, prefer, require, verify-ca or verify-full
DB_MAX_CONNS=20          # per pod; replicas x this must stay below Postgres max_connections

# --- Listeners ---
PUBLIC_ADDR=:3001        # behind the ingress: UI, OIDC endpoints, /api
INTERNAL_ADDR=:3002      # cluster-only: /metrics, /healthz, /readyz

# --- Public identity ---
# Public base URL of Guardian as seen by browsers. https:// enables Secure + __Host- cookies.
ISSUER_URL=http://localhost:3001
# Extra browser origins allowed to call /api (comma separated). ISSUER_URL is always allowed.
ALLOWED_ORIGINS=
# Number of reverse proxies (ingress, load balancer) that append to X-Forwarded-For. 0 = none.
TRUSTED_PROXY_HOPS=0

# --- Secrets ---
# Encrypts signing keys at rest. Generate: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
# Optional. If unset, a random admin password is generated and logged once on first start.
ADMIN_INITIAL_PASSWORD=
# --- Sessions (optional, Go durations) ---
# A sign-in session ends after this long without use. Refreshing an app's tokens counts as use.
SESSION_IDLE_TIMEOUT=168h
# ...and this long after sign-in at the latest, however active it is.
SESSION_MAX_LIFETIME=720h

# --- Logging ---
LOG_FORMAT=text          # json (default, for clusters) or text (easier to read locally)
LOG_LEVEL=info           # debug, info, warn or error
